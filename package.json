{
  "name": "role-playing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Voice role-play platform for practising workplace English and French.",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:bench": "vitest run --project bench",
    "mutation": "stryker run",
    "eval": "node --env-file-if-exists=.env tools/eval-harness-cli/src/cli.ts",
    "validate:tasks": "node --env-file-if-exists=.env tools/eval-harness-cli/src/cli.ts validate-tasks",
    "langfuse:deploy": "bash scripts/langfuse.sh deploy",
    "langfuse:up": "bash scripts/langfuse.sh up",
    "langfuse:down": "bash scripts/langfuse.sh down",
    "langfuse:logs": "bash scripts/langfuse.sh logs",
    "langfuse:health": "bash scripts/langfuse.sh health",
    "langfuse:tunnel": "bash scripts/langfuse.sh tunnel",
    "langfuse:untunnel": "bash scripts/langfuse.sh untunnel",
    "langfuse:env": "bash scripts/langfuse.sh env",
    "langfuse:verify": "node --env-file-if-exists=.env scripts/langfuse-verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@livekit/rtc-node": "^1.2.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
