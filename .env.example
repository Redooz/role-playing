# Secrets for local runs. Never commit the real file.
#
# Copy this file to .env and fill it in. Keys stay in the environment;
# scripts load it with `node --env-file-if-exists=.env`.
#
# Persona providers. The default is LiveKit Inference `google/gemma-4-31b-it`;
# OpenRouter remains for Jev grading and historical probes; Groq is the
# historical pinned path. Base URLs are optional: the defaults are shown here so
# a proxy or gateway can be swapped without editing code.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Jev semantic grading and the historical OpenRouter probes use this key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LiveKit Inference is the default persona provider and uses the project API key
# and secret; both are required for live sessions and the `livekit/` labels.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_INFERENCE_URL=https://agent-gateway.livekit.cloud/v1

# Langfuse review layer (M0.1). Self-hosted only: never point this at
# Langfuse Cloud. `npm run langfuse:deploy` fills these in from the Docker host;
# `LANGFUSE_ENABLED=false` keeps eval runs fully offline.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional: the headless-init project id, used to build experiment URLs.
LANGFUSE_PROJECT_ID=
