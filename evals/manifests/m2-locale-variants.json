{
  "schemaVersion": "3.0.0",
  "run": {
    "runId": "m2-locale-variants",
    "suite": "m2-locale-variants",
    "purpose": "capability",
    "description": "M2 locale probe: the same three personas and scenario types with en-GB and fr-CA variants, reported per locale."
  },
  "tasks": {
    "dataset": "synthetic-workplace-session",
    "version": "v1",
    "languages": ["en", "fr"],
    "locales": ["en-GB", "fr-CA"],
    "splits": ["calibration"]
  },
  "seeds": {
    "master": 20261109,
    "algorithm": "mulberry32"
  },
  "grader": {
    "id": "jev",
    "kind": "system-one-model",
    "version": "typesafe/jev-1.14",
    "model": "typesafe/jev-1.14"
  },
  "rubric": {
    "version": "m2-persona-rubric-v1",
    "ids": ["m2-persona-rubric-v1"]
  },
  "limits": {
    "rounds": 3,
    "maxFailureRate": 0.1
  },
  "target": {
    "metric": "locale.fit",
    "direction": "increase",
    "minimumDetectableEffect": 0.1
  },
  "guardrails": [
    {
      "metric": "persona.consistency",
      "direction": "increase",
      "tolerance": 0.05
    },
    {
      "metric": "language.quality",
      "direction": "increase",
      "tolerance": 0.05
    },
    {
      "metric": "register.fit",
      "direction": "increase",
      "tolerance": 0.05
    },
    {
      "metric": "response.clarity",
      "direction": "increase",
      "tolerance": 0.05
    },
    {
      "metric": "objective.completion",
      "direction": "increase",
      "tolerance": 0.05
    },
    {
      "metric": "response.plain_text_rate",
      "direction": "increase",
      "tolerance": 0
    },
    {
      "metric": "response.emoji_count",
      "direction": "decrease",
      "tolerance": 0
    },
    {
      "metric": "response.markdown_count",
      "direction": "decrease",
      "tolerance": 0
    },
    {
      "metric": "run.failure_rate",
      "direction": "decrease",
      "tolerance": 0.05
    }
  ],
  "invariants": [
    "transcript.schema_valid",
    "transcript.guard_clean",
    "transcript.seq_monotonic",
    "transcript.content_class",
    "response.plain_text"
  ],
  "provider": {
    "mode": "live",
    "label": "groq/openai/gpt-oss-20b",
    "allowLive": true,
    "paceMs": 10500
  },
  "prompt": {
    "version": "m2-prompt-v1",
    "mode": "persona",
    "currentDate": "2026-11-08",
    "parameters": {
      "temperature": 0.6,
      "topP": 0.95,
      "maxCompletionTokens": 512,
      "reasoningEffort": "low",
      "includeReasoning": false
    }
  },
  "baseline": {
    "runId": "m2-locale-baseline",
    "metrics": {
      "persona.consistency": 0.541667,
      "language.quality": 0.931667,
      "register.fit": 0.764444,
      "response.clarity": 0.869444,
      "objective.completion": 0.803333,
      "locale.fit": 0.674444,
      "response.plain_text_rate": 1,
      "response.emoji_count": 0,
      "response.markdown_count": 0,
      "run.failure_rate": 0
    }
  }
}
