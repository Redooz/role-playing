{
  "schemaVersion": "3.0.0",
  "run": {
    "runId": "m0-canned-replay",
    "suite": "m0-canned-replay",
    "description": "Gate G1: replay every synthetic EN/FR task twice with the canned provider and require byte-identical normalized transcripts.",
    "purpose": "regression"
  },
  "tasks": {
    "dataset": "synthetic-workplace",
    "version": "v1",
    "languages": ["en", "fr"],
    "splits": ["calibration", "holdout"]
  },
  "seeds": {
    "master": 20261025,
    "algorithm": "mulberry32"
  },
  "grader": {
    "id": "deterministic-invariants",
    "kind": "code",
    "version": "1.0.0"
  },
  "rubric": {
    "version": "m0-harness-v1"
  },
  "limits": {
    "rounds": 2,
    "maxFailureRate": 0
  },
  "target": {
    "metric": "replay.deterministic_rate",
    "direction": "increase",
    "minimumDetectableEffect": 0
  },
  "guardrails": [
    {
      "metric": "transcript.schema_valid_rate",
      "direction": "increase",
      "tolerance": 0
    },
    {
      "metric": "transcript.content_class_rate",
      "direction": "increase",
      "tolerance": 0
    },
    {
      "metric": "transcript.guard_violations",
      "direction": "decrease",
      "tolerance": 0
    },
    {
      "metric": "run.failure_rate",
      "direction": "decrease",
      "tolerance": 0
    }
  ],
  "invariants": [
    "transcript.schema_valid",
    "transcript.guard_clean",
    "transcript.seq_monotonic",
    "transcript.content_class"
  ],
  "provider": {
    "mode": "canned",
    "label": "m0-task-persona-v1",
    "allowLive": false
  },
  "baseline": {
    "runId": "m0-canned-replay-bootstrap",
    "metrics": {
      "replay.deterministic_rate": 1,
      "transcript.schema_valid_rate": 1,
      "transcript.content_class_rate": 1,
      "transcript.guard_violations": 0,
      "run.failure_rate": 0
    }
  }
}
