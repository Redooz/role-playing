{
  "schemaVersion": "3.0.0",
  "run": {
    "runId": "m2-persona-fr-register-v1",
    "suite": "m2-persona-fr-register",
    "purpose": "regression",
    "description": "French-only regression after the prompt v2 register fix: the peer keeps tu, manager and client keep vous, and no axis drops against the French subset of the accepted v4 capability run. This is not a capability claim; the deterministic prompt tests prove the contradiction is gone."
  },
  "tasks": {
    "dataset": "synthetic-workplace-session",
    "version": "v1",
    "languages": ["fr"],
    "splits": ["calibration"]
  },
  "seeds": {
    "master": 20261108,
    "algorithm": "mulberry32"
  },
  "grader": {
    "id": "jev",
    "kind": "system-one-model",
    "version": "typesafe/jev-1.14",
    "model": "typesafe/jev-1.14"
  },
  "rubric": {
    "version": "m2-persona-rubric-v2",
    "ids": ["m2-persona-rubric-v2"]
  },
  "limits": {
    "rounds": 5,
    "maxFailureRate": 0.1
  },
  "target": {
    "metric": "persona.consistency",
    "direction": "increase",
    "minimumDetectableEffect": 0
  },
  "guardrails": [
    {
      "metric": "language.quality",
      "direction": "increase",
      "tolerance": 0.05
    },
    {
      "metric": "register.fit",
      "direction": "increase",
      "tolerance": 0.05
    },
    {
      "metric": "response.clarity",
      "direction": "increase",
      "tolerance": 0.05
    },
    {
      "metric": "objective.completion",
      "direction": "increase",
      "tolerance": 0.05
    },
    {
      "metric": "response.plain_text_rate",
      "direction": "increase",
      "tolerance": 0
    },
    {
      "metric": "response.emoji_count",
      "direction": "decrease",
      "tolerance": 0
    },
    {
      "metric": "response.markdown_count",
      "direction": "decrease",
      "tolerance": 0
    },
    {
      "metric": "run.failure_rate",
      "direction": "decrease",
      "tolerance": 0.1
    }
  ],
  "invariants": [
    "transcript.schema_valid",
    "transcript.guard_clean",
    "transcript.seq_monotonic",
    "transcript.content_class",
    "response.plain_text"
  ],
  "provider": {
    "mode": "live",
    "label": "livekit/google/gemma-4-31b-it",
    "allowLive": true,
    "paceMs": 1000
  },
  "prompt": {
    "version": "m2-prompt-gemma-v2",
    "mode": "persona",
    "currentDate": "2026-11-08",
    "parameters": {
      "temperature": 0.6,
      "topP": 0.95,
      "maxCompletionTokens": 1024
    },
    "style": "gemma"
  },
  "baseline": {
    "runId": "m2-persona-scenarios-lk-v4",
    "metrics": {
      "persona.consistency": 0.860667,
      "language.quality": 0.917333,
      "register.fit": 0.931333,
      "response.clarity": 0.912,
      "objective.completion": 0.888,
      "response.plain_text_rate": 1,
      "response.emoji_count": 0,
      "response.markdown_count": 0,
      "run.failure_rate": 0
    }
  }
}
