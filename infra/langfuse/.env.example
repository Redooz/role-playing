# Server-side secrets for the self-hosted Langfuse stack.
#
# Copy this file to `.env` (or run `scripts/gen-env.sh`) and fill every value.
# `.env` is git-ignored. Generate secrets with `openssl rand -hex 32`.
#
# The pinned Langfuse release. The JS/TS SDK v6 requires server >= 4.59.0.
LANGFUSE_IMAGE_TAG=4.76.0

# Public URL of the web UI. It is bound to 127.0.0.1 on the host.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
SALT=
# 64 hex characters: `openssl rand -hex 32`.
ENCRYPTION_KEY=

POSTGRES_USER=langfuse
POSTGRES_PASSWORD=
POSTGRES_DB=langfuse

CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=

REDIS_AUTH=

MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=

# Headless initialization. On first boot Langfuse creates this organization,
# project, user and the two API keys, so the stack needs no click-through setup.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=Role-Playing
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=role-playing-evals
# Must start with `pk-lf-`.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# Must start with `sk-lf-`.
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=evals@example.com
LANGFUSE_INIT_USER_NAME=Evaluator
LANGFUSE_INIT_USER_PASSWORD=
