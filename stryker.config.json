{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "packages/session-core/src/**/*.ts",
    "!packages/session-core/src/**/*.spec.ts",
    "packages/pipeline/src/**/*.ts",
    "!packages/pipeline/src/**/*.spec.ts",
    "packages/persona-kit/src/prompt/**/*.ts",
    "!packages/persona-kit/src/prompt/**/*.spec.ts",
    "packages/persona-kit/src/lookup.ts",
    "packages/scenario-kit/src/lookup.ts",
    "packages/scenario-kit/src/scenarios/helpers.ts",
    "packages/shared/src/locale.ts",
    "packages/shared/src/plain-text.ts",
    "apps/cli/src/cli-main.ts",
    "apps/cli/src/main.ts",
    "apps/cli/src/session-log.adapter.ts"
  ],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "timeoutMS": 30000,
  "concurrency": 4,
  "tempDirName": ".stryker-tmp",
  "thresholds": {
    "high": 68.22,
    "low": 68.21,
    "break": 68.21
  }
}
