{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "packages/session-core/src/**/*.ts",
    "!packages/session-core/src/**/*.spec.ts",
    "packages/pipeline/src/**/*.ts",
    "!packages/pipeline/src/**/*.spec.ts",
    "packages/persona-kit/src/prompt/**/*.ts",
    "!packages/persona-kit/src/prompt/**/*.spec.ts",
    "packages/persona-kit/src/lookup.ts",
    "packages/scenario-kit/src/lookup.ts",
    "packages/scenario-kit/src/scenarios/helpers.ts",
    "packages/routing-policy/src/**/*.ts",
    "!packages/routing-policy/src/**/*.spec.ts",
    "!packages/routing-policy/src/schemas.ts",
    "!packages/routing-policy/src/fixtures.ts",
    "packages/turn-arbiter/src/**/*.ts",
    "!packages/turn-arbiter/src/**/*.spec.ts",
    "!packages/turn-arbiter/src/fixtures.ts",
    "packages/shared/src/locale.ts",
    "packages/shared/src/plain-text.ts",
    "packages/eval-harness/src/**/*.ts",
    "!packages/eval-harness/src/**/*.spec.ts",
    "!packages/eval-harness/src/**/*.fixtures.ts",
    "apps/cli/src/cli-main.ts",
    "apps/cli/src/main.ts",
    "apps/cli/src/session-log.adapter.ts",
    "tools/*/src/**/*.ts",
    "!tools/*/src/**/*.spec.ts",
    "!tools/eval-harness-cli/src/cli.ts",
    "!tools/routing-bench/src/compare.ts",
    "!tools/routing-bench/src/compare-main.ts",
    "!tools/routing-bench/src/m3b-shadow.cli.ts",
    "!tools/routing-bench/src/m3b-shadow.ts",
    "!tools/routing-bench/src/m3d-calibration.cli.ts",
    "!tools/routing-bench/src/m3d-calibration.ts",
    "tools/annotation-kit/routing-labels.mjs"
  ],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "timeoutMS": 30000,
  "concurrency": 4,
  "tempDirName": ".stryker-tmp",
  "thresholds": {
    "high": 96,
    "low": 95,
    "break": 95
  }
}
